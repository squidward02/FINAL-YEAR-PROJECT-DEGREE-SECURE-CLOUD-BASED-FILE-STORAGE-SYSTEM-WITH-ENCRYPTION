rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user data with error handling
    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data 
        : null;
    }
    
    // Helper function to get user role safely
    function getUserRole() {
      let userData = getUserData();
      return userData != null ? userData.role : 'viewer';
    }
    
    // Helper function to check user role
    function hasRole(role) {
      return isAuthenticated() && getUserRole() == role;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return hasRole('admin');
    }
    
    // Helper function to check if user is editor or admin
    function canEdit() {
      return hasRole('admin') || hasRole('editor');
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own document, admins can read all
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      // Users can create their own document on signup
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // Users can update their own document (for profile info, 2FA, etc.)
      // BUT cannot change their own role - only admins can change roles
      // Admins can update any user (including role changes)
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && 
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))) ||
        isAdmin()
      );

      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // Files collection - RBAC implementation
    match /files/{fileId} {
      // Helper function to check if user has access to file
      function hasFileAccess(fileData) {
        // Owner always has access
        let isOwner = request.auth.uid == fileData.uploadedBy;
        
        // Check if user is in allowedUsers array (handle null case)
        let isAllowedUser = fileData.allowedUsers != null && request.auth.uid in fileData.allowedUsers;
        
        // Check if user's role is in allowedRoles array (handle null case)
        let hasAllowedRole = fileData.allowedRoles != null && getUserRole() in fileData.allowedRoles;
        
        // Admin always has access to all files
        let isAdminUser = isAdmin();
        
        return isOwner || isAllowedUser || hasAllowedRole || isAdminUser;
      }
      
      // Read: Allow all authenticated users to read all files for browsing
      // This enables the FileBrowser component to show all files
      // Actual access control (download/view) is handled on the frontend
      allow read: if isAuthenticated();
      
      // Create: Only authenticated users with editor or admin role
      allow create: if isAuthenticated() && canEdit() 
                    && request.resource.data.uploadedBy == request.auth.uid
                    && request.resource.data.allowedUsers is list
                    && request.resource.data.allowedRoles is list;
      
      // Update: Owner or admin can update
      allow update: if isAuthenticated() && (
        resource.data.uploadedBy == request.auth.uid || isAdmin()
      );
      
      // Delete: Owner or admin can delete
      allow delete: if isAuthenticated() && (
        resource.data.uploadedBy == request.auth.uid || isAdmin()
      );
    }    // Folders collection
    match /folders/{folderId} {
      // Helper function to check folder access
      function hasFolderAccess(folderData) {
        let isOwner = request.auth.uid == folderData.createdBy;
        let isAdminUser = isAdmin();
        return isOwner || isAdminUser;
      }

      // Read: Owner or admin
      allow read: if isAuthenticated() && hasFolderAccess(resource.data);

      // Create: Editor or admin can create folders
      allow create: if isAuthenticated() && canEdit()
                    && request.resource.data.createdBy == request.auth.uid;

      // Update/Delete: Owner or admin
      allow update, delete: if isAuthenticated() && hasFolderAccess(resource.data);
    }

    // Activity Logs collection - Only admins can read, system writes
    match /activityLogs/{logId} {
      // Only admins can read activity logs
      allow read: if isAdmin();

      // Any authenticated user can create activity logs (for their own actions)
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // No updates or deletes allowed
      allow update, delete: if false;
    }

    // Access Requests collection
    match /accessRequests/{requestId} {
      // Users can read their own requests, admins can read all
      allow read: if isAuthenticated() && (
        resource.data.requestedBy == request.auth.uid || isAdmin()
      );

      // Any authenticated user can create access requests
      allow create: if isAuthenticated()
                    && request.resource.data.requestedBy == request.auth.uid
                    && request.resource.data.status == 'pending';

      // Only admins can update (approve/deny)
      allow update: if isAdmin();

      // Users can delete their own pending requests, admins can delete any
      allow delete: if isAuthenticated() && (
        (resource.data.requestedBy == request.auth.uid && resource.data.status == 'pending')
        || isAdmin()
      );
    }

    // Share Links collection
    match /shareLinks/{linkId} {
      // Anyone can read share links (for public sharing)
      allow read: if true;

      // Only file owners or admins can create share links
      allow create: if isAuthenticated() && (
        request.resource.data.createdBy == request.auth.uid || isAdmin()
      );

      // Only creator or admin can update
      allow update: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid || isAdmin()
      );

      // Only creator or admin can delete
      allow delete: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid || isAdmin()
      );
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}